#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<long long>a(n);
        long long sum=0;
        long long mx=0;
        for(int i=0;i<n;i++){
            cin>>a[i];
            sum+=a[i];
            mx=max(mx,a[i]);
            
        }
        long long ans=sum-mx;
        for(int i=0;i<n;i++){
            long long newsum=sum+a[i];
            long long newmx=max(mx,2*a[i]);
            ans=max(ans,newsum-newmx);
        }
        cout<<ans<<endl;
    }
    return 0;
}
