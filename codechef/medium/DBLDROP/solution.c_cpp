#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n);
        int sum=0;
        int mx=0;
        for(int i=0;i<n;i++){
            cin>>a[i];
            sum+=a[i];
            mx=max(mx,a[i]);
            
        }
        int ans=sum-mx;
        for(int i=0;i<n;i++){
            int newsum=sum+a[i];
            int newmx=max(mx,2*a[i]);
            ans=max(ans,newsum-newmx);
        }
        cout<<ans<<endl;
    }
    
}
